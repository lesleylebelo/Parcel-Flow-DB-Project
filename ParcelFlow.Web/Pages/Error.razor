@page "/Error"

<div class="card" style="max-width:480px; margin:60px auto; text-align:center;">
    <i class="bi bi-exclamation-triangle" style="font-size:2rem; color:var(--pf-status-delayed);"></i>
    <h2 style="margin-top:12px;">Something went wrong</h2>
    <p style="color:var(--pf-grey-med);">An unexpected error occurred while processing your request.</p>
    <a href="/" class="btn btn-primary" style="margin-top:8px;">Return to Home</a>
</div>
