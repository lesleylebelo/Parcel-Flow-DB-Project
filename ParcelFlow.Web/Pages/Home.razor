@page "/"

<h1>ParcelFlow</h1>
<p>Courier operations portal for a fictional multi-region delivery company (Johannesburg, Cape Town, Durban).</p>

<div class="card-grid">
    <div class="card">
        <h3>📍 Track a Parcel</h3>
        <p>Look up a parcel by ID and see its full status history.</p>
        <a href="/track"><button>Track a Parcel</button></a>
    </div>
    <div class="card">
        <h3>🗂️ Manage Parcels</h3>
        <p>Browse, add, edit, and remove parcel records.</p>
        <a href="/parcels"><button>Manage Parcels</button></a>
    </div>
    <div class="card">
        <h3>📊 Dashboard</h3>
        <p>Revenue by centre, revenue by service type, and delivery status breakdown.</p>
        <a href="/dashboard"><button>Open Dashboard</button></a>
    </div>
</div>
