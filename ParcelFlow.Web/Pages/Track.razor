@page "/track"
@inject ParcelService ParcelSvc

<div class="section">
    <h1>Track a Parcel</h1>
    <p style="color:var(--pf-grey-med); margin:0;">Enter a parcel ID to see its current status and full delivery history.</p>
</div>

<div class="card section" style="max-width:480px;">
    <div class="search-input">
        <i class="bi bi-hash"></i>
        <input type="number" @bind="_searchId" placeholder="e.g. 1050" />
    </div>
    <button class="btn btn-primary" style="margin-top:10px; width:100%; justify-content:center;" @onclick="Search">
        <i class="bi bi-search"></i> Track Parcel
    </button>
</div>

@if (_searched && _parcel == null)
{
    <div class="card" style="border-left:3px solid var(--pf-status-delayed);">
        <i class="bi bi-exclamation-circle" style="color:var(--pf-status-delayed);"></i>
        No parcel found with ID <strong>#@_searchId</strong>.
    </div>
}

@if (_parcel != null)
{
    <div class="card-grid" style="grid-template-columns: 1.4fr 1fr;">
        <div class="card">
            <div class="form-section-title">Shipment Information</div>
            <table style="font-size:0.85rem;">
                <tbody>
                    <tr><td style="color:var(--pf-grey-med); width:40%;">Parcel ID</td><td><strong>#@_parcel.ParcelID</strong></td></tr>
                    <tr><td style="color:var(--pf-grey-med);">Customer</td><td>@_parcel.Customer?.CustomerName</td></tr>
                    <tr><td style="color:var(--pf-grey-med);">Service</td><td>@_parcel.ServiceType?.ServiceName</td></tr>
                    <tr><td style="color:var(--pf-grey-med);">Origin</td><td>@_parcel.Origin</td></tr>
                    <tr><td style="color:var(--pf-grey-med);">Destination</td><td>@_parcel.Destination</td></tr>
                    <tr><td style="color:var(--pf-grey-med);">Distribution Centre</td><td>@_parcel.DistributionCentre</td></tr>
                    <tr><td style="color:var(--pf-grey-med);">Dispatched</td><td>@_parcel.DispatchDate.ToString("dd MMM yyyy")</td></tr>
                </tbody>
            </table>
        </div>

        <div class="card">
            <div class="form-section-title">Delivery Status</div>
            <div style="margin-bottom:16px;"><StatusBadge Status="@_parcel.CurrentStatus" /></div>

            <div class="form-section-title">Tracking Timeline</div>
            @if (_history.Count == 0)
            {
                <p style="color:var(--pf-grey-med); font-size:0.85rem;"><em>No status changes recorded yet.</em></p>
            }
            else
            {
                <ul class="timeline">
                    @for (int i = 0; i < _history.Count; i++)
                    {
                        var h = _history[i];
                        <li class="timeline-item @(i == _history.Count - 1 ? "done" : "")">
                            <div class="timeline-status">@h.Status</div>
                            <div class="timeline-date">@h.ChangedAt.ToString("dd MMM yyyy, HH:mm")</div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
}

@code {
    private int _searchId;
    private bool _searched;
    private Parcel? _parcel;
    private List<ParcelStatusHistory> _history = new();

    private async Task Search()
    {
        _searched = true;
        _parcel = await ParcelSvc.GetParcelAsync(_searchId);
        _history = _parcel != null
            ? await ParcelSvc.GetStatusHistoryAsync(_searchId)
            : new List<ParcelStatusHistory>();
    }
}
